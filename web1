<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TradeHub Marketplace</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->
    <header class="header">

        <div class="logo">
            Trade<span>Hub</span>
        </div>

        <nav>
            <a href="#home">Home</a>
            <a href="#products">Products</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>
        </nav>

        <button class="cart-button" onclick="openCart()">
            🛒 Cart (<span id="cartCount">0</span>)
        </button>

    </header>


    <!-- HERO SECTION -->
    <section id="home" class="hero">

        <div class="hero-content">

            <h1>Buy & Sell With Confidence</h1>

            <p>
                Find quality shoes, televisions and motorbikes
                at great prices.
            </p>

            <button onclick="scrollToProducts()">
                Shop Now
            </button>

        </div>

    </section>


    <!-- SEARCH -->
    <section class="search-section">

        <input
            type="text"
            id="searchInput"
            placeholder="Search for shoes, TVs, motorbikes..."
            onkeyup="searchProducts()"
        >

    </section>


    <!-- CATEGORY BUTTONS -->
    <section class="categories">

        <button onclick="filterProducts('all')">
            All
        </button>

        <button onclick="filterProducts('shoes')">
            👟 Shoes
        </button>

        <button onclick="filterProducts('tv')">
            📺 Televisions
        </button>

        <button onclick="filterProducts('motorbikes')">
            🏍️ Motorbikes
        </button>

    </section>


    <!-- PRODUCTS -->
    <section id="products" class="products-section">

        <h2>Featured Products</h2>

        <div id="productGrid" class="product-grid"></div>

    </section>


    <!-- ABOUT -->
    <section id="about" class="about">

        <h2>About TradeHub</h2>

        <p>
            TradeHub is an online marketplace where customers
            can discover and order shoes, televisions and
            motorbikes.
        </p>

    </section>


    <!-- CONTACT -->
    <section id="contact" class="contact">

        <h2>Contact Us</h2>

        <p>Have questions about a product?</p>

    

        <a href="mailto: g21074167@gmail.com" class="email-button">
            📧 Email Us
        </a>

    </section>


    <!-- CART MODAL -->
    <div id="cartModal" class="modal">

        <div class="modal-content">

            <span class="close" onclick="closeCart()">
                &times;
            </span>

            <h2>Your Shopping Cart</h2>

            <div id="cartItems"></div>

            <h3>
                Total:
                ₦<span id="cartTotal">0</span>
            </h3>

            <button class="checkout-button" onclick="openCheckout()">
                Checkout
            </button>

        </div>

    </div>


    <!-- CHECKOUT MODAL -->
    <div id="checkoutModal" class="modal">

        <div class="modal-content">

            <span class="close" onclick="closeCheckout()">
                &times;
            </span>

            <h2>Place Your Order</h2>

            <form id="orderForm">

                <input
                    type="text"
                    id="customerName"
                    placeholder="Your full name"
                    required
                >

                <input
                    type="email"
                    id="customerEmail"
                    placeholder="Your email"
                    required
                >

                <input
                    type="tel"
                    id="customerPhone"
                    placeholder="Your phone number"
                    required
                >

                <textarea
                    id="customerAddress"
                    placeholder="Delivery address"
                    required
                ></textarea>

                <button type="submit">
                    Place Order
                </button>

            </form>

            <p id="orderMessage"></p>

        </div>

    </div>


    <footer>

        <p>
            © 2026 TradeHub Marketplace. All rights reserved.
        </p>

    </footer>


    <script src="script.js"></script>

</body>
</html>
